# Server-only environment. Copy to .env.local for local overrides.
APP_NAME="Zaraff Collection Dashboard"
DATABASE_URL="file:./dev.db?connection_limit=1"
JWT_SECRET="ganti-dengan-rahasia-panjang-untuk-produksi"
APP_URL="http://localhost:3000"
SESSION_COOKIE_SECURE="false"
# Enable only behind a trusted proxy that replaces X-Forwarded-For.
TRUST_PROXY="false"
UPLOAD_DIR="./uploads"
# Optional server-only Gemini extraction. CSV/manual input works without these.
GEMINI_API_KEY=""
GEMINI_MODEL=""
# Optional seed overrides: SEED_PASSWORD_OWNER, SEED_PASSWORD_ADMIN,
# SEED_PASSWORD_PENYORTIR, SEED_PASSWORD_LIVE_HOST, SEED_PASSWORD_PACKING.
# Variables prefixed with NEXT_PUBLIC_ are included in browser bundles.
# Never put passwords, database URLs, or API secrets in NEXT_PUBLIC_ variables.
