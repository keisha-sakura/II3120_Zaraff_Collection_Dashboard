{
  "name": "zaraff-collection-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:legacy": "node --experimental-strip-types --test tests/*.test.mjs",
    "design:inventory": "node scripts/design-inventory.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "db:generate": "prisma generate",
    "seed": "prisma db seed",
    "db:push": "prisma db push",
    "db:migrate": "node --experimental-strip-types scripts/database.ts migrate",
    "db:seed": "node --experimental-strip-types scripts/database.ts seed",
    "db:setup": "node --experimental-strip-types scripts/database.ts setup",
    "db:backup": "node --experimental-strip-types scripts/database.ts backup",
    "db:reset": "node --experimental-strip-types scripts/database.ts reset"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prisma": "^6.19.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
